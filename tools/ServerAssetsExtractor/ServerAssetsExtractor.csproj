<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ServerAssetsExtractor</AssemblyName>
    <RootNamespace>ServerAssetsExtractor</RootNamespace>
    <Version>3.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- CUE4Parse marks its older provider constructors obsolete; this tool does not use them. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <!-- Release exe: dotnet publish -c Release -r win-x64 (see README.md) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned: the library FModel uses. Bump deliberately and re-run the verify step. -->
    <PackageReference Include="CUE4Parse" Version="1.2.2.202610" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.8" />
    <!-- Lifts a vulnerable 9.0.0 that CUE4Parse's audio dependency pulls in. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Update="rules.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="rules.json" LogicalName="rules.json" />
  </ItemGroup>

</Project>
